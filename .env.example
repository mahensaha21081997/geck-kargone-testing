# Copy this file to .env and fill in the secret.
# Start with: node --env-file=.env server.mjs
# Do not send .env to anyone. .gitignore already skips it.

# Required. At least 16 characters. Use the same value as GROK_RELAY_TOKEN in the Geck backend.
GROK_RELAY_TOKEN=replace-with-a-long-secret

# Optional. Defaults shown below.
PORT=4010
HOST=127.0.0.1
GROK_BOT_NAME=Grok Bot
GROK_BOT_CLI=gbot

# On this Windows PC, point GROK_BOT_CLI at the gbot script, for example:
# GROK_BOT_CLI=C:\Users\Mahen Saha\AppData\Roaming\npm\node_modules\grok-bot-cli\dist\bin\gbot.mjs
